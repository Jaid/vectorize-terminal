{
  "name": "vectorize-terminal",
  "version": "0.1.0",
  "type": "module",
  "description": "Render ANSI terminal transcripts as deterministic, fixed-grid SVG screenshots.",
  "keywords": [
    "ansi",
    "terminal",
    "svg",
    "screenshot",
    "cli",
    "typescript"
  ],
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/vectorize-terminal.git"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "bin": {
    "vectorize-terminal": "./dist/cli.js"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "export:fixtures": "bun run scripts/export-fixtures.ts",
    "lint": "eslint .",
    "prepack": "bun run check",
    "test": "bun test --max-concurrency 1 ./test",
    "test:browser": "bun run scripts/check-browser.ts",
    "test:package": "bun run scripts/check-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "string-width": "8.2.2"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-jaid": "33.0.0",
    "fs-extra": "11.4.0",
    "playwright": "1.63.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.4.2",
    "@types/fs-extra": "11.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs/example.svg"
  ],
  "sideEffects": false
}
